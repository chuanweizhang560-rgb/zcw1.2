<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- TL Towers -->
    <include>
      <uri>model://TL</uri>
      <name>tower1</name>
      <pose>30 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://TL</uri>
      <name>tower2</name>
      <pose>-30 0 0 0 0 0</pose>
    </include>

    <!-- Desert terrain heightmap -->
    <model name="desert_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>model://desert_terrain/heightmap/desert_heightmap.png</uri>
              <size>300 300 8</size>
              <pos>0 0 -1</pos>
            </heightmap>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <texture>
                <diffuse>file://media/materials/textures/dirt_diffusespecular.png</diffuse>
                <normal>file://media/materials/textures/dirt_normal.png</normal>
                <size>10</size>
              </texture>
              <uri>model://desert_terrain/heightmap/desert_heightmap.png</uri>
              <size>300 300 8</size>
              <pos>0 0 -1</pos>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
  </world>
</sdf>
