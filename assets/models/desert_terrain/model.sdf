<?xml version="1.0"?>
<sdf version="1.5">
  <model name="desert_terrain">
    <static>true</static>
    <link name="terrain">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>__default__</uri>
            <size>300 300 8</size>
            <pos>0 0 -1</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <texture>
              <diffuse>file://media/materials/textures/dirt_diffusespecular.png</diffuse>
              <normal>file://media/materials/textures/dirt_normal.png</normal>
              <size>10</size>
            </texture>
            <uri>__default__</uri>
            <size>300 300 8</size>
            <pos>0 0 -1</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
